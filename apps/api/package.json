{
  "name": "@nexa/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:check": "drizzle-kit check",
    "migrate:generate": "drizzle-kit generate",
    "migrate:check": "drizzle-kit check",
    "scheduler": "node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/workers/scheduler.js",
    "smoke:wss": "node scripts/smoke-wss.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.0.0",
    "@hono/swagger-ui": "^0.4",
    "@hono/zod-validator": "^0.4.1",
    "@mathieuc/tradingview": "^3.5.2",
    "@mayanfinance/swap-sdk": "^15.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@nexa/shared-zod": "workspace:*",
    "@nktkas/hyperliquid": "^0.33.1",
    "@polymarket/builder-relayer-client": "0.0.10",
    "@polymarket/builder-signing-sdk": "1.0.0",
    "@polymarket/clob-client-v2": "1.0.8",
    "@privy-io/server-auth": "^1.18.0",
    "@sentry/node": "^10.57.0",
    "@solana/web3.js": "^1.98.4",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.13",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-sentry-transport": "^1.6.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "resend": "^4.0.1",
    "siwe": "^3.0.0",
    "stripe": "22.2.1",
    "viem": "^2.21.55",
    "web-push": "^3.6.7",
    "ws": "8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}

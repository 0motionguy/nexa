# MAZE API env — every integration below is env-gated. Unset = demo fallback.
# Set the keys you have; the rest stay on demo. See HANDOVER.md §11 for the
# integration matrix.

# --- runtime ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=8090
DEMO_MODE=1
ALLOW_DEMO_IN_PRODUCTION=0

# --- database (reuse toolbox-postgres) ---
DATABASE_URL=postgresql://toolbox:toolbox@localhost:5432/toolbox

# --- queue (reuse toolbox-redis) ---
REDIS_URL=redis://:toolbox@localhost:6379

# --- auth ---
JWT_SECRET=nexa-demo-secret-change-in-prod
NEXA_AGENT_KEYS=nx_live_7f3k_demo
DEMO_OTP_CODE=482019
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# --- chain ---
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=
BASE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/
# Legacy HOSTUP/toolbox env name accepted as a fallback when BASE_RPC_URL is unset.
CHAINSTACK_BASE_RPC_URL=
GNOSIS_RPC_URL=https://rpc.gnosischain.com
# Sprint 19 — multi-chain RPC URLs for /balances + CCTP routing. Optional;
# defaults fall back to public RPCs. Override with your Alchemy/Chainstack
# URLs in production for higher rate limits. Only the chains in active
# buckets (Arbitrum/Polygon/Base/Solana) are read; Optimism is supported at
# the CCTP-protocol level but not in any bucket.
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
# Onramper widget API key (https://onramper.com/widget). Optional; falls back
# to the sandbox widget when absent. Powers POST /onramp/onramper/session.
ONRAMPER_API_KEY=
# Sprint 20 — Collector Crypt cards marketplace (NEO Cards tab).
# CC's API is keyless (wallet-sig auth); NEXA proxies through these endpoints
# so signing key material stays server-side. Devnet:
# CC_API_BASE=https://dev-api.collectorcrypt.com
CC_API_BASE=https://api.collectorcrypt.com
CC_ENABLED=1
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Defi token + protocol addresses on Base mainnet. Defaults work for prod;
# override on testnets or when the curator/strategy moves.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
EURC_ADDRESS=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
# yoUSD ERC-4626 vault (primary earn target).
YOUSD_ADDRESS=0x0000000f2eB9f69274678c76222B35eEc7588a65
# Aave v3 Pool + aUSDC (diversification).
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
AUSDC_ADDRESS=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB
# Compound v3 Comet (cUSDCv3) market on Base.
COMPOUND_COMET_ADDRESS=0xb125E6687d4313864e53df431d5425969c15Eb2F

# --- bridge.xyz (KYC + virtual accounts) ---
BRIDGE_API_KEY=
BRIDGE_API_BASE=https://api.sandbox.bridge.xyz
BRIDGE_WEBHOOK_SECRET=

# --- LIFI (cross-chain swap) ---
LIFI_API_KEY=

# --- gnosis pay (permissionless card) ---
GNOSIS_PAY_BASE=https://api.gnosispay.com
GNOSIS_PAY_API_KEY=

# --- sponge (agent cards + bank accounts) ---
SPONGE_API_BASE=https://api.paysponge.com
SPONGE_API_KEY=

# --- resend (transactional email; falls back to stdout when unset) ---
RESEND_API_KEY=
RESEND_FROM=MAZE <hello@nexa.aiso.tools>

# --- observability ---
# Sentry: set DSN to enable error reporting + warn-level pino transport.
SENTRY_DSN=
# Fraction of transactions sampled for performance (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Prometheus /metrics endpoint. METRICS_TOKEN is the Bearer token scrapers
# present in the Authorization header; unset = endpoint returns 404.
METRICS_ENABLED=0
METRICS_TOKEN=

# --- PWA push notifications (optional; generate with web-push VAPID tooling) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@maze.to

# --- admin sweeps (Sprint 10 ε) ---
# Bearer token required to call POST /admin/sweep-claims and
# /admin/sweep-subscriptions (manual triggers for the same store methods the
# scheduler invokes on a cron). Unset = admin routes refuse.
ADMIN_TOKEN=

# --- compose / deploy ---
# Container tag used by infra/compose-fragment.yml when pulling images.
# Override per deploy: `NEOBANK_TAG=sha-abc1234 docker compose up -d ...`.
NEOBANK_TAG=latest

# --- x402 ---
X402_FACILITATOR_URL=https://x402.coinbase.com
X402_DEMO_MODE=1

# --- payment links ---
PAY_LINK_BASE_URL=https://maze.to/pay
# Public base for claim emails - maze.aiso.tools/claim/<slug> during preview.
CLAIM_LINK_BASE_URL=https://maze.aiso.tools/claim
# Public base for hosted offer checkout links - maze.to/o/<id>
CHECKOUT_BASE_URL=https://maze.to/o

# --- sumsub (KYC; gates identity verification when set) ---
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE=https://api.sumsub.com

# --- markets (six venues + revenue / builder fees) ---
# Active venues: Hyperliquid perps + spot, trade.xyz HIP-3 stocks (Hyperliquid
# builder DEX `xyz`), Backed Finance xStocks (Solana SPL Token-2022 via
# Jupiter), Jupiter memes (pump.fun + Jupiter Token API), Polymarket
# predictions. Defaults ON so demo surfaces sample prices/odds with zero
# config. Set to 0 to hide the markets surface entirely.
MARKETS_ENABLED=1
# Jupiter swaps require explicit opt-in plus Privy Solana wallet signing and Solana RPC.
JUPITER_SWAPS_ENABLED=0

# Runtime kill switches consumed by NEO. Comma-separated declared subsystem
# names; for example: venueLiveTrading,proChart
SAFE_MODE_DISABLED=

# --- Hyperliquid + HIP-3 (trade.xyz) builder fees ---
# Builder address surfaced in Hyperliquid builder-fee approval params. Same
# address earns on canonical perps AND HIP-3 stock perps — set once, collect
# everywhere. EVM address (preferably a hardware wallet or Privy server wallet).
HL_BUILDER_ADDRESS=
# Tenths of a basis point for the Hyperliquid builder fee (25 = 2.5 bps;
# 50 = 5 bps; 100 = 10 bps = HL maximum). When enabled, the backend signs
# the one-time `approveBuilderFee` agreement during account setup or the
# first live HL action, then attaches the builder fee to later orders.
HYPERLIQUID_BUILDER_FEE_TENTHS_BP=
HYPERLIQUID_REFERRAL_CODE=

# --- Jupiter platform fee (memes + xStocks) ---
# NEXA platform fee on every Jupiter swap, in basis points (50 = 0.50%).
# Capped at 100 by Jupiter. Default 0 = pass-through (no fee). Production
# target: 50 bps. Collected in the OUTPUT token at JUPITER_PLATFORM_FEE_ACCOUNT.
JUPITER_PLATFORM_FEE_BPS=
# Solana base58 address of the NEXA fee receiver. Must be an associated
# token account (ATA) for the output mint, or a wrapped-SOL ATA for SOL
# outputs. Without this address, fees are skipped even if BPS is set.
# See docs/FEES.md for the ATA pre-creation procedure.
JUPITER_PLATFORM_FEE_ACCOUNT=

# --- Polymarket builder credentials + per-user CLOB encryption ---
# Live writes also need per-user L2 CLOB creds; PM_CLOB_ENC_KEY below
# encrypts those user-specific secrets at rest.
POLY_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYMARKET_BUILDER_ADDRESS=
POLYMARKET_BUILDER_FEE_BPS=
POLYMARKET_BUILDER_CODE=

# --- Solana RPC for Marinade write paths ---
CHAINSTACK_SOLANA_RPC_URL=
SOLANA_RPC_URL=
HELIUS_RPC_URL=

# --- cors ---
WEB_ORIGIN=http://localhost:5173
PORTAL_ORIGIN=http://localhost:5173

# --- stack upgrades phase 1 (earn router) ---
# MORPHO_VAULT_ADDRESS: the Steakhouse-curated USDC vault on Base — the
# "Standard" tier in the earn router. Same Morpho vault that backs Coinbase's
# USDC lending product. Verify on app.morpho.org/base before first live
# deposit >= $1k. Override to swap curator/strategy without code changes.
# Source: https://app.merkl.xyz/opportunities/base/MORPHOVAULT/0xbeeF010f9cb27031ad51e3333f9aF9C6B1228183
#         https://morpho.org/blog/morpho-is-now-powering-usdc-lending-on-coinbase/
MORPHO_VAULT_ADDRESS=0xbeeF010f9cb27031ad51e3333f9aF9C6B1228183

# MORPHO_HIGH_YIELD_VAULT_ADDRESS (Sprint 16 yield-tier wiring): higher-yield
# Morpho vault address on Base. Used by the earn router to surface a
# "Higher Yield" tier alongside the Standard MORPHO_VAULT_ADDRESS above.
# Override per environment. Unset = the high-yield tier reports docs-only.
MORPHO_HIGH_YIELD_VAULT_ADDRESS=

# --- stack upgrades phase 2 (socket bridge router) ---
# SOCKET_API_KEY: get from https://socket.tech (Bungee dashboard). When set,
# the bridge router prefers Socket and falls back to LIFI if no route is
# returned. Unset = LIFI is the only provider.
SOCKET_API_KEY=
# SOCKET_API_BASE: default https://backend.socket.tech (domain-whitelisted)
# or https://dedicated-backend.socket.tech (API-key-gated dedicated endpoint).
SOCKET_API_BASE=https://backend.socket.tech

# --- stack upgrades phase 4 (stripe checkout) ---
# STRIPE_SECRET_KEY: get from https://dashboard.stripe.com/apikeys. When set,
# POST /checkout/:id/pay with `method: 'card'` returns a real Stripe Checkout
# redirectUrl. Unset = synthetic `cs_demo_<hex>` redirect for e2e fixtures.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: webhook endpoint signing secret from the Stripe
# dashboard. Gates HMAC verification of checkout.session.completed at
# POST /checkout/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL: Stripe interpolates
# {CHECKOUT_SESSION_ID} server-side. Point at the public checkout host once
# DNS for checkout.maze.bank is cut over.
STRIPE_SUCCESS_URL=https://checkout.maze.bank/return?session={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://checkout.maze.bank/cancel?session={CHECKOUT_SESSION_ID}

# --- alertmanager fanout (Sprint 12 Phase 2) ---
# Slack incoming-webhook URL the AlertManager forwards alerts to. Generate at
# https://api.slack.com/messaging/webhooks. Consumed by the toolbox host's
# AlertManager container (via /opt/toolbox/.env), NOT by the MAZE api or
# scheduler — documented here for env-key discovery only. Routing config
# lives in infra/alertmanager/config.yml.
ALERTMANAGER_SLACK_WEBHOOK_URL=

# --- sec-01 at-rest secret encryption (Sprint 17.5) ---
# Base64-encoded 32-byte master key for AES-256-GCM wrapping of Polymarket
# CLOB credentials (and any other per-user secrets stored in nb_users).
# Generate ONCE: openssl rand -base64 32 — back up offline before deploying.
# In production this MUST be set; in dev/test, unset = encryption is a no-op
# (pass-through) so existing fixtures keep working.
PM_CLOB_ENC_KEY=

# --- privy webhook (auth.* events) ---
# Privy's outbound webhook signing secret. Validates POST /auth/privy-webhook.
PRIVY_WEBHOOK_SECRET=

# --- monerium (EU EUR <-> EURe on Gnosis Chain) ---
# Alternative to Bridge for EU users while Bridge KYB is pending. The IBAN is
# issued in the user's name (Monerium is an EU e-money institution; not
# custodial-to-MAZE).
MONERIUM_API_KEY=
MONERIUM_API_SECRET=
MONERIUM_API_BASE=

# --- morpho graphql (vault APY reads) ---
MORPHO_API_URL=https://api.morpho.org/graphql

# --- yousd APY ---
# Leave unset rather than displaying a fake rate. The adapter reports APY
# unavailable until a real provider URL is configured.
YOUSD_APY_URL=

# --- jwt rotation (F020) ---
# Optional comma-separated HS256 secrets for zero-downtime rotation. New
# tokens are signed with the FIRST secret; verification accepts ANY in the
# list. Unset = single-secret behaviour using JWT_SECRET.
JWT_SECRETS=

# --- hardening middleware (Sprint 11 Phase 0) ---
# Flip to 0 in dev/test to bypass the sliding-window rate limiter (existing
# specs do this per-test). Webhook freshness window (Stripe-style) gates the
# bridge / kyc replay guard; 5 min mirrors Stripe's default.
RATE_LIMIT_ENABLED=1
WEBHOOK_FRESHNESS_WINDOW_SECONDS=300

# --- realtime hub (verified 2026-07-16) ---
# Default OFF ('0'): /v1/stream/ws + /ws/markets 404 until flipped. Flip in
# prod ONLY per the runbook in docs/READINESS-2026-07-16.md (hardening specs
# green + smoke:wss green + bounded canary). Web/mobile clients are flag-gated
# separately (VITE_REALTIME_HUB_ENABLED / EXPO_PUBLIC_REALTIME_HUB_ENABLED).
REALTIME_HUB_V1=0
# Shared WS+SSE client budget, single process (capacity.ts). 1000-user target
# fits with headroom; raise only with replicas + cross-pod fan-out review.
REALTIME_MAX_CLIENTS=1500
# Sub-budgets inside the global cap (readiness audit 2026-07-16): one
# credential ≤8 sockets, one NAT egress ≤64. BOTH transports draw these —
# WS sheds with close 1013, SSE with 503 JSON, same reason/code
# user_capacity / ip_capacity (Codex review 2026-07-16: SSE previously
# bypassed the sub-budgets). IP key = lib/rate-limit clientIp()
# (TRUSTED_PROXY_HOPS-gated — forged x-forwarded-for can't bypass the cap).
# Prod Compose forwards all three via infra/compose-fragment.yml.
REALTIME_MAX_CONNS_PER_USER=8
REALTIME_MAX_CONNS_PER_IP=64
# Server→client WS keepalive ms (0 = off). Surfaces dead peers and defeats
# proxy idle reaping between ticks.
REALTIME_KEEPALIVE_MS=30000

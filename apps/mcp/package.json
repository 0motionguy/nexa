{
  "name": "@nexa/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Neo Bank / NEXA public API — gives AI agents (Claude, ChatGPT, custom) direct access to markets, profile, and trading.",
  "type": "module",
  "private": true,
  "bin": {
    "nexa-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@nexa/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}

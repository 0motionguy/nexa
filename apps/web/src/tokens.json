{
  "$schema": "https://json.schemastore.org/design-tokens",
  "$description": "NEXA design tokens — machine-readable export of tokens.css + tokens.semantic.css. Source of truth lives in app-v2.html :root.",
  "color": {
    "bg": { "value": "#F5F6FA", "type": "color" },
    "surface": { "value": "#FFFFFF", "type": "color" },
    "fg": { "value": "#090A0C", "type": "color" },
    "muted": { "value": "#4F535C", "type": "color" },
    "meta": { "value": "#8A8D96", "type": "color" },
    "accent": { "value": "#FF6A1A", "type": "color" },
    "accent-deep": { "value": "#C84D12", "type": "color" },
    "success": { "value": "#18A957", "type": "color" },
    "warn": { "value": "#F5A524", "type": "color" },
    "danger": { "value": "#E5484D", "type": "color" },
    "ink": { "value": "#0A0A0C", "type": "color" },
    "ink-fg": { "value": "#F4F5F8", "type": "color" }
  },
  "color-dark": {
    "bg": { "value": "#0A0A0C", "type": "color" },
    "surface": { "value": "#121215", "type": "color" },
    "fg": { "value": "#F4F5F8", "type": "color" }
  },
  "radius": {
    "sm": { "value": "10px", "type": "dimension" },
    "md": { "value": "14px", "type": "dimension" },
    "lg": { "value": "22px", "type": "dimension" },
    "pill": { "value": "999px", "type": "dimension" }
  },
  "spacing": {
    "1": { "value": "4px", "type": "dimension" },
    "2": { "value": "8px", "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "5": { "value": "20px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "8": { "value": "32px", "type": "dimension" }
  },
  "shadow": {
    "soft": { "value": "0 10px 40px rgba(10, 10, 12, .08)", "type": "shadow" },
    "card": { "value": "0 16px 45px rgba(30, 34, 44, .12)", "type": "shadow" },
    "phone": { "value": "0 34px 80px rgba(10, 10, 12, .22)", "type": "shadow" }
  },
  "font": {
    "mono": { "value": "'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace", "type": "fontFamily" },
    "sans": { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif", "type": "fontFamily" }
  },
  "motion": {
    "ease": { "value": "cubic-bezier(.2, .65, .25, 1)", "type": "cubicBezier" }
  }
}

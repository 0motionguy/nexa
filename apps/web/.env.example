# MAZE web client — shared with AISO (aiso.to) and NEO (neo.aiso.tools).
#
# IMPORTANT: copy to .env.local and DO NOT commit. The same Privy app powers
# AISO + NEO + Maze, so the user identity (DID) is unified across all three.
# Mismatching this value here breaks cross-app sign-in.

# Public Privy app + client IDs (same as neo/eas.json + aiso/.env.local).
VITE_PRIVY_APP_ID=cmp185m9g00jp0el4spa4zqvj
VITE_PRIVY_CLIENT_ID=client-WY6ZMZctaWMpr7oSfXHZutSuYYJxDX3FoZfhHDfYSrcvk

# Override the on-chain pay-link host for hosted checkout (defaults to https://maze.to/pay).
# VITE_MAZE_PAY_BASE_URL=

# Override the NEXA backend base URL (defaults to /api on the same origin via Vite proxy in dev).
# VITE_NEXA_API_BASE=

# Shared realtime hub (apps/api/src/realtime/*) — when '1' or 'true', MAZE
# subscribes to ticker/candle/predictions fan-out via /ws/markets instead of
# opening direct vendor sockets. Default off; flip per-env after the C7
# smoke described in nexa/docs/REALTIME-MARKETS.md.
# VITE_REALTIME_HUB_ENABLED=

# NEO terminal deep-link base. MAZE market sheets show an "Open advanced
# terminal" button that opens this base + the market path. Set to empty to
# hide the button entirely.
# VITE_NEO_TERMINAL_URL=https://neo.aiso.tools

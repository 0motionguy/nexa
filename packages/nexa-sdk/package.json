{
  "name": "@nexa/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Neo Bank / NEXA public API — markets, profile, payments, x402, all in one typed surface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:types": "node scripts/gen-openapi-types.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
